# Site URL (apna domain)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Admin login (optional - default waheed999 / code me set hai)
ADMIN_USER=waheed999
ADMIN_PASS=change-me
AUTH_SECRET=koi-lamba-random-text
# Admin edits save karne ke liye: Vercel > Storage > Upstash Redis (KV) connect karo
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Image upload ke liye: Vercel > Storage > Blob connect karo
BLOB_READ_WRITE_TOKEN=

# AI Product Writer (admin). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
